# clean up genome sequences

from Bio import SeqIO

#!/usr/bin/python3
from Bio import SeqIO
file_dict = {}
with open("fna_file_list.txt") as fafile:
    for line in fafile:
        spl_file = line.split("_")
        outfile = spl_file[2] + ".fasta"
        file_dict[line[8:-1]] = outfile

for k, v in file_dict.items():
    with open(k, "r") as infile, open(v, "w") as outf:
        for seq in SeqIO.parse(infile, 'fasta'):
            seq.name = ""
            seq.description = ""
            outf.write(seq.format('fasta'))


