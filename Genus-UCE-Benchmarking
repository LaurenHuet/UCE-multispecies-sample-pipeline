## 1.  250,000 reads simulated per species (deemed to be low coverage)


##rename the samples 
rundir=~/uce_assembly_project/read-sim/reads

for i in $rundir/*; do

sample=$(basename $i)

reads_dir=$rundir/$sample/capsim_illumina
 
mv $reads_dir/sample_1_1.fastq.gz $reads_dir/$sample.1.fastq.gz
mv $reads_dir/sample_1_2.fastq.gz $reads_dir/$sample.2.fastq.gz

done 

## cat samples together 

rundir=~/uce_assembly_project/read-sim/reads

for i in $rundir/*; do

