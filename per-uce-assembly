LutBoha_index="/home/lhuet/UCE-PROJECT/meta/reads/indexes/LutBoha"
LutJohn_index="/home/lhuet/UCE-PROJECT/meta/reads/indexes/LutJohn"
LutQuin_index="/home/lhuet/UCE-PROJECT/meta/reads/indexes/LutQuin"


# index the genomes

bwa index CepArgu_218174_F16_0236.fasta
bwa index LutBita_276526_F16-0187.fasta
bwa index LutBoha_218479_F16-0235.fasta
bwa index LutJohn_218496_F15-0241.fasta
bwa index LutQuin.218497_OG10G.fasta

###
# Map back to genomes ~ doing the separalty for now, can wrap this up in a nextflow later on if needed 
###

for directory in uce-*; do
    bwa mem $CepArgu_index/CepArgu_218174_F16_0236.fasta ${directory}/${directory}_contigs.fasta > ${directory}_CepArgu_mapped.sam 
