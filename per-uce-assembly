for directory in uce-*; do
    bwa mem $LutBita_index/LutBita_276526_F16-0187.fasta ${directory}/${directory}_contigs.fasta  > ${directory}_LutBita_mapped.sam 
done


for directory in uce-*; do
 bwa mem $LutBoha_index/LutBoha_218479_F16-0235.fasta ${directory}/${directory}_contigs.fasta  > ${directory}_LutBoha_mapped.sam 
done


for directory in uce-*; do
 bwa mem $LutJohn_index/LutJohn_218496_F15-0241.fasta ${directory}/${directory}_contigs.fasta  > ${directory}_LutJohn_mapped.sam 
done


for directory in uce-*; do
 bwa mem $LutQuin_index/LutQuin.218497_OG10G.fasta ${directory}/${directory}_contigs.fasta  > ${directory}_LutQuin_mapped.sam 
done

